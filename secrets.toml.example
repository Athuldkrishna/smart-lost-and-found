# Copy this file to .streamlit/secrets.toml and fill in your values.
# Supabase Dashboard → Project Settings → API (or "API Keys")

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"

# Use the SECRET key (sb_secret_...) or the legacy "service_role" key.
# It stays on the Streamlit server only — never put it in frontend code or git.
SUPABASE_KEY = "sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"
